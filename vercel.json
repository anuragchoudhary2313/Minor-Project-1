{
  "version": 2,
  "buildCommand": "cd Gofood && npm install --legacy-peer-deps && npm run build",
  "framework": "create-react-app",
  "outputDirectory": "Gofood/build",
  "routes": [
    {
      "src": "/api/.*",
      "dest": "https://your-backend-url.vercel.app/api"
    },
    {
      "src": "/(?!.*\\.).*",
      "dest": "/index.html"
    }
  ]
}
