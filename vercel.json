{
  "version": 2,
  "buildCommand": "cd Gofood && npm install && npm run build",
  "framework": "react",
  "outputDirectory": "Gofood/build",
  "env": {
    "REACT_APP_API_URL": "@react_app_api_url"
  },
  "routes": [
    {
      "src": "/api/.*",
      "dest": "https://your-backend-url.vercel.app/api"
    },
    {
      "src": "/(?!.*\\.).*",
      "dest": "/index.html"
    }
  ]
}
